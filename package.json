{
  "name": "mos-scene-hunt",
  "version": "0.1.0",
  "private": true,
  "description": "MOS Scene Hunt V0.1 - a mobile-first real-world location-based scenario hunt game engine",
  "license": "MIT",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:acceptance": "node tests/e2e/run.mjs",
    "test:acceptance:rebuild": "node tests/e2e/run.mjs --rebuild",
    "test:acceptance:only": "node tests/e2e/run-e2e.mjs"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "idb-keyval": "^6.2.1",
    "leaflet": "^1.9.4",
    "next": "16.4.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "^16.1.0",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "4.1.12",
    "autoprefixer": "^10.4.20",
    "esbuild": "0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.1",
    "puppeteer-core": "25.14.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "4.1.12"
  }
}
