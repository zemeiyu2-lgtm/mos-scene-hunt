  "private": true,
  "description": "MOS Scene Hunt V0.1 - a mobile-first real-world location-based scenario hunt game engine",
  "license": "MIT",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
