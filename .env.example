# 已发布游戏存储配置（服务器开发第一阶段）
# 只需声明变量名与用途；真实凭据一律在部署平台的环境变量设置中配置，严禁提交。

# 存储适配器选择：
#   留空 / "fs"   = 本地文件系统适配器（默认），仅适合本地开发与单机 Node 部署；
#                    在 Vercel 等无持久化文件系统的平台上数据会随实例丢失。
#   "blob"        = Vercel Blob 适配器，持久化且跨实例共享，生产部署使用；
#                    必须同时配置 BLOB_READ_WRITE_TOKEN。
PUBLISHED_GAMES_STORE=

# 文件系统适配器的存储目录（仅 PUBLISHED_GAMES_STORE=fs 时生效）。
# 默认 <项目根>/.published-games（已在 .gitignore 中忽略）。
PUBLISHED_GAMES_DIR=

# Vercel Blob 读写令牌（仅 PUBLISHED_GAMES_STORE=blob 时生效）。
# 在 Vercel 项目 Settings -> Environment Variables 中配置，或本地 `vercel env pull`。
# 本仓库代码不读取、不记录、不存储该令牌的值。
BLOB_READ_WRITE_TOKEN=

# 可选：Vercel Blob 内的根前缀（默认 published-games）。
PUBLISHED_GAMES_BLOB_PREFIX=

# ---------------------------------------------------------------------------
# 地图引擎（仅 test/map-vendors 分支）
# ---------------------------------------------------------------------------
# 留空 / "leaflet" = 现有 Leaflet + OpenStreetMap（默认，行为与正式版一致）
# "openfreemap"    = MapLibre + OpenFreeMap 公共实例（无 Key）
# "protomaps"      = MapLibre + Protomaps PMTiles（默认公共构建，可换自托管地址）
# "geoapify"       = Leaflet + Geoapify 栅格瓦片（需要下方 Key）
# "amap"           = 高德引擎在本分支不可用（见 test/amap-world-map 分支）
NEXT_PUBLIC_MAP_ENGINE=

# OpenFreeMap 样式（liberty/bright/positron/dark/fiord，默认 liberty）
NEXT_PUBLIC_OFM_STYLE=

# Protomaps PMTiles 地址。默认 latest.protomaps.com 公共构建（官方不建议生产热链）；
# 正式方案应指向自托管对象存储（R2/S3）+ pmtiles extract 的区域切片。
NEXT_PUBLIC_PMTILES_URL=
# Protomaps 风格：light/dark/white/grayscale/black
NEXT_PUBLIC_PROTOMAPS_FLAVOR=

# Geoapify Key（免费计划 3000 credits/天，4 瓦片=1 credit）。严禁提交真实值。
NEXT_PUBLIC_GEOAPIFY_KEY=
# Geoapify 样式（osm-bright/osm-clean/positron/dark-matter/klokantech-basic）
NEXT_PUBLIC_GEOAPIFY_STYLE=
